    "staging:office-review-evidence": "tsx src/companions/office-companion/staging/review-evidence.ts",
    "test": "npm run validate:billy && npm run validate:office && npm run validate:office-staging && npm run validate:office-evidence-review && npm run typecheck && npm run acceptance:family && npm run acceptance:office && npm run smoke:office-server && npm run acceptance:office-gemini && npm run acceptance:office-multi && npm run acceptance:office-staging && npm run acceptance:office-evidence-review && npm run build:office"
