{
  "name": "phoenix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:office": "tsc -p tsconfig.build.json",
    "start:office": "node dist/companions/office-companion/server.js",
    "validate:billy": "node scripts/validate-billy.mjs",
    "validate:office": "node scripts/validate-office-companion.mjs",
    "validate:office-staging": "node scripts/validate-office-staging.mjs",
    "validate:office-evidence-review": "node scripts/validate-office-evidence-review.mjs",
    "acceptance:family": "tsx src/modules/family/fixtures/run-acceptance-suite.ts",
    "acceptance:office": "tsx src/companions/office-companion/fixtures/run-acceptance-suite.ts",
    "acceptance:office-gemini": "tsx src/companions/office-companion/fixtures/run-gemini-adapter-acceptance.ts",
    "acceptance:office-multi": "tsx src/companions/office-companion/fixtures/run-multi-provider-acceptance.ts",
    "acceptance:office-staging": "tsx src/companions/office-companion/fixtures/run-staging-proof-acceptance.ts",
    "acceptance:office-evidence-review": "tsx src/companions/office-companion/fixtures/run-evidence-review-acceptance.ts",
    "smoke:office-server": "tsx src/companions/office-companion/fixtures/run-server-smoke.ts",
